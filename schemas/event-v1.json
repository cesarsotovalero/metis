{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextScope synthetic metadata envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "session_id",
    "producer_id",
    "producer_epoch",
    "schema_version",
    "observed_at_unix_ms",
    "visibility",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "producer_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "schema_version": {
      "const": 1
    },
    "producer_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "observed_at_unix_ms": {
      "type": "integer"
    },
    "source_timestamp_unix_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "visibility": {
      "const": "synthetic"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "session_started"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "session_ended"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "request_id"
          ],
          "properties": {
            "kind": {
              "const": "request_started"
            },
            "request_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "request_id"
          ],
          "properties": {
            "kind": {
              "const": "request_completed"
            },
            "request_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "request_id"
          ],
          "properties": {
            "kind": {
              "const": "request_failed"
            },
            "request_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "request_id",
            "mode",
            "usage"
          ],
          "properties": {
            "kind": {
              "const": "usage_observed"
            },
            "request_id": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "cumulative",
                "delta"
              ]
            },
            "usage": {
              "$ref": "#/$defs/usage"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool_id"
          ],
          "properties": {
            "kind": {
              "const": "tool_started"
            },
            "tool_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool_id",
            "exit_code"
          ],
          "properties": {
            "kind": {
              "const": "tool_completed"
            },
            "tool_id": {
              "type": "string"
            },
            "exit_code": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tool_id"
          ],
          "properties": {
            "kind": {
              "const": "tool_failed"
            },
            "tool_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "visibility_gap"
            },
            "code": {
              "type": "string"
            }
          }
        }
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uncached_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cache_read_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cache_write_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "total_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "visible_output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reasoning_output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "total_output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reasoning_included_in_output": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    }
  }
}
